@model List<WebApp1_T1.Data.Workshop>

@{
    ViewData["Title"] = "Home Page";
}

<a href=""><button class="btn btn-primary">Новое оборудование</button></a>

<table class="table">
    <tr>
        <th>Цех</th>
        <th>Оборудование</th>
        <th>Действия</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.workshop</td>
            <td>>@item.equipment</td>
            <td>
                <a href="">Редактировать</a>
                <a href="">Удалить</a>
            </td>
        </tr>
        
    }

  

</table>




